  },
  "render_products": {
    "isaac_foreground": [
      "rgb",
      "depth_m",
      "instance_id",
      "alpha_derived_from_instance_id"
    ],
    "gaussian_background": [
      "rgb",
      "depth_m",
      "alpha"
    ],
    "composite": {
      "rule": "nearest_valid_depth_with_alpha",
      "depth_epsilon_m": 0.003,
      "output_format": "lossless_png",
      "atomic_episode_publication": true,
      "intermediate_retention": "failures_and_debug_samples_only"
    }
  },
  "recording": {
    "canonical_episode_protocol": "conveyor-bench-v1",
    "canonical_camera_index": "camera_frames.jsonl",
    "additional_camera_pose_index": "camera_poses.jsonl",
    "policy_camera_ids": [
      "head_rgb",
      "wrist_rgb"
    ],
    "observer_camera_ids": [
      "overview_rgb"
    ],
    "raw_to_training_export": "existing_conveyorvla_al0_lerobot_v3",
    "training_video_format": "mp4",
    "action_and_state_schema_changes": false
  },
  "acceptance_gates": {
    "asset": {
      "all_required_files_local": true,
      "symlinks_allowed": false,
      "sha256_manifest_required": true,
      "runtime_network_access": false
    },
    "calibration": {
      "minimum_control_points": 12,
      "median_reprojection_error_px_max": 1.5,
      "p95_reprojection_error_px_max": 3.0,
      "scale_error_percent_max": 1.0
    },
    "render": {
      "held_out_static_psnr_db_min": 25.0,
      "held_out_static_ssim_min": 0.85,
      "dynamic_static_edge_error_px_p95_max": 3.0,
      "missing_or_duplicate_frames_allowed": 0,
      "black_or_frozen_policy_frames_allowed": 0
    },
    "data": {
      "v1_strict_validator_required": true,
      "temporal_camera_gate_required": true,
      "lerobot_round_trip_required": true,
      "overview_as_policy_input_allowed": false
    }
  },
  "implementation_stages": [
    "A_asset_capture_and_calibration",
    "B_local_ply_loader_and_gsplat_renderer",
    "C_three_camera_pose_export",
    "D_isaac_foreground_and_depth_aware_compositor",
    "E_single_episode_stationary_smoke",
    "F_low_speed_dynamic_smoke",
    "G_twenty_episode_pilot_collection"
  ]
}
