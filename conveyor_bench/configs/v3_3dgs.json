{
  "schema_version": 1,
  "profile_id": "conveyor-bench-v3-3dgs",
  "status": "design",
  "collection_ready": false,
  "version_boundary": {
    "canonical_protocol": "conveyor-bench-v1",
    "base_scene_config": "configs/v1.json",
    "initial_scene_id": "transverse_dynamic_sort_station_v3_3dgs",
    "scope": "near_conveyor_single_target",
    "frozen_training_contract": true
  },
  "runtime": {
    "backend": "hybrid_two_pass_3dgs",
    "network_required": false,
    "runtime_downloads_allowed": false,
    "external_project_files_required": false,
    "project_relative_assets_only": true,
    "deterministic_offline_compositing": true
  },
  "rates_hz": {
    "physics": 400,
    "control": 50,
    "camera": 25,
    "model": 25
  },
  "physics_layer": {
    "source_scene": "transverse_dynamic_sort_station_v1",
    "engine": "Isaac Sim/PhysX",
    "reuse_without_geometry_changes": [
      "go2_x5_robot",
      "surface_velocity_conveyor",
      "object_registry",
      "receptacles",
      "contact_sensors",
      "teacher",
      "success_evaluator"
    ],
    "collision_source": "existing_procedural_v1_colliders",
    "gaussian_splats_have_collision": false
  },
  "gaussian_layer": {
    "asset_root": "assets/workcells/conveyor_station_v3_3dgs",
    "asset_manifest": "assets/workcells/conveyor_station_v3_3dgs/ASSET_MANIFEST.json",
    "visual_ply": "assets/workcells/conveyor_station_v3_3dgs/scene_static_gaussians.ply",
    "calibration": "assets/workcells/conveyor_station_v3_3dgs/calibration_sim_from_gs.json",
    "capture_masks": "assets/workcells/conveyor_station_v3_3dgs/capture_masks",
    "photometric_calibration": "assets/workcells/conveyor_station_v3_3dgs/photometric_calibration.json",
    "renderer": "gsplat",
    "render_mode": "RGB+D",
    "coordinate_policy": "transform_gaussians_into_sim_world_on_load",
    "ply_contract": {
      "format": "binary_little_endian_1.0",
      "scalar_type": "float32",
      "required_vertex_properties": [
        "x",
        "y",
        "z",
        "f_dc_0",
        "f_dc_1",
        "f_dc_2",
        "opacity",
        "scale_0",
        "scale_1",
        "scale_2",
        "rot_0",
        "rot_1",
        "rot_2",
        "rot_3"
      ]
    },
    "load_defaults": {
      "max_gaussians_preview": 2000000,
      "max_gaussians_collection": 0,
      "chunk_gaussians": 500000,
      "sample_stride": 1,
      "opacity_threshold": 0.0,
      "radius_clip": 0.0,
      "rasterize_mode": "antialiased"
    }
  },
  "visual_partition": {
    "static_in_3dgs": [
      "room_shell",
      "floor",
      "fixed_lighting_appearance",
      "fixed_conveyor_frame",
      "fixed_safety_fence",
      "fixed_background_furniture"
    ],
    "dynamic_in_isaac": [
      "go2_x5_robot",
      "arm_and_gripper",
      "moving_belt_surface",
      "task_objects",
      "receptacles",
      "task_markers"
    ],
    "excluded_from_static_capture": [
      "go2_x5_robot",
      "arm_and_gripper",
      "moving_belt_surface",
      "task_objects",
      "receptacles",
      "task_markers",
      "people"
    ]
  },
  "camera_trajectory": {
    "schema": "conveyor_bench.camera_trajectory.v1",
    "output": "camera_poses.jsonl",
    "pose_source": "USD_world_transform_after_fabric_update",
    "pose_convention": "T_sim_world_from_camera_usd",
    "camera_axes": {
      "forward": "-Z",
      "up": "+Y",
      "right": "+X"
    },
    "record_each_camera_tick": true,
    "required_fields": [
      "frame_index",
      "sim_step",
      "timestamp_s",
      "camera_id",
      "intrinsics_3x3",
      "T_sim_world_from_camera_4x4",
      "near_m",
      "far_m"
    ]
  },
  "cameras": {
    "head_rgb": {
      "resolution": [
        640,
