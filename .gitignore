# Canonical local artifact tree.  Keep code/config/docs in Git and keep
# datasets, checkpoints, runs, environments, dependencies, and bundles here.
outputs/
/artifacts/
*.bundle

# Prevent the legacy scattered workspace layout from reappearing inside the
# repository.  The compatibility aliases live outside this Git worktree.
