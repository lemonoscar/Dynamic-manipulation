conveyor_bench/outputs/

# SSH-delivered NuRec/object sidecar assets (never publish to Git)
.local_assets/
assets_sidecar/
conveyor_bench/.local_assets/
conveyor_bench/assets_sidecar/

# Local project-planning document (do not publish)
/毕业设计计划.pdf

# Strictly local agent/server handoff material; never publish.
/handoff_private/

